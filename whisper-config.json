{
    "ui": {
        "calm_mode": false,
        "rec_overlay": true,
        "dashboard_history_entries": 8,
        "preserve_dashboard_history": true
    },
    "logging": {
        "save_history": true,
        "max_file_size_mb": 10
    },
    "hotkeys": {
        "dictation": "ctrl+alt+d"
    },
    "audio": {
        "sample_rate": 16000,
        "beep_volume": 0.1,
        "silence_timeout_seconds": 20
    },
    "model": {
        "size": "large-v3-turbo",
        "device": "cuda",
        "compute_type": "float16",
        "download_root": null
    },
    "transcription": {
        "dictation_language": "de",
        "beam_size": 3,
        "batch_size": 8,
        "vad_filter": true,
        "condition_on_previous_text": false,
        "initial_prompt": "CLAUDE.md, Whisper, faster-whisper, Python, CUDA, RTX 4060, committe, pushe, Punkt, YOLO, TryoTrix, CMD, committen, pushen, Commit, Push",
        "no_speech_threshold": null,
        "debug_transcription": true,
        "short_text_max_words": 3
    },
    "post_processing": {
        "apply_spoken_punctuation": true,
        "spoken_punctuation": {
            "[,\\s]*[-–]?\\s*Doppelpunkt[,\\s]*": ": ",
            "[,\\s]*[-–]?\\s*Semikolon[,\\s]*": "; ",
            "[,\\s]*[-–]?\\s*Ausrufezeichen": "!",
            "[,\\s]*[-–]?\\s*Fragezeichen": "?",
            "[,\\s]*[-–]?\\s*Gedankenstrich[,\\s]*": " - ",
            "[,\\s]*[-–]?\\s*(?:Schrägstrich|Slash)[,\\s]*": "/",
            "[,\\s]*[-–]?\\s*Anführungszeichen[,\\s]*": "\""
        },
        "word_corrections": {
            "\\bTrio[\\s-]?Tri(?:x|cks?)\\b": "TryoTrix",
            "\\bClaude\\.md\\b": "CLAUDE.md",
            "\\bFaster[\\s-]?Whisper\\b": "faster-whisper",
            "\\bTrial[\\s-]?Tricks?\\b": "TryoTrix",
            "\\bTry[\\s-]?o[\\s-]?Tricks?\\b": "TryoTrix",
            "\\bTryo[\\s-]?Tricks?\\b": "TryoTrix",
            "\\bTry[\\s-]?your[\\s-]?Tricks?\\b": "TryoTrix",
            "\\bTriotricks?\\b": "TryoTrix",
            "\\bTryotricks?\\b": "TryoTrix"
        },
        "hallucination_phrases": [
            "untertitelung von zdf",
            "untertitel von zdf",
            "untertitelung des zdf",
            "untertitel des zdf",
            "untertitel der amara.org-community",
            "copyright wdr",
            "copyright swr",
            "vielen dank fürs zuschauen",
            "vielen dank für's zuschauen",
            "danke fürs zuschauen",
            "thanks for watching",
            "thank you for watching",
            "ich danke euch fürs zuschauen",
            "untertitelung des zdf, 2020",
            "untertitelung des zdf 2020"
        ],
        "hallucination_phrases_low_confidence": [
            "vielen dank",
            "danke",
            "tschüss",
            "bis zum nächsten mal"
        ],
        "hallucination_logprob_threshold": -1.0,
        "hallucination_patterns": [
            "^untertitel(ung)?\\b.*\\b(zdf|ard|br|wdr|swr|ndr|mdr|rbb|orf|srf|amara|20\\d\\d)\\b"
        ]
    }
}
